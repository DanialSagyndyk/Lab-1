# Firebase Web Configuration
# Copy this file to .env.local and replace the placeholder values with your Firebase project credentials.
# You can find these in Firebase Console:
# Project Settings (gear icon) > General > Your apps > Web app (</>) > Firebase SDK snippet > Config

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
